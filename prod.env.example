# Production environment – copy to prod.env and fill values.
# prod.env is gitignored; NEVER commit it.

# Pre-built image tag – build with Dockerfile.frappe and push to your registry.
# Example: ghcr.io/yourorg/mpit-frappe:v16.10.1-1.2.3
CUSTOM_IMAGE=ghcr.io/yourorg/mpit-frappe
CUSTOM_TAG=v16.10.1-1.0.0

# MariaDB root password (must match what was used at site creation).
DB_ROOT_PASSWORD=changeme_strong

# Nginx binding (default: localhost only; change 0.0.0.0 to expose directly)
HTTP_BIND=127.0.0.1
HTTP_PORT=9797

# Site routing: $$host sends the incoming Host header as site name (multi-tenant).
# Set to a fixed site name if you run a single site.
FRAPPE_SITE_NAME_HEADER=$$host

# Optional nginx tuning
# PROXY_READ_TIMEOUT=120
# CLIENT_MAX_BODY_SIZE=50m
