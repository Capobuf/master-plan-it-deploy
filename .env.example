# Development environment for the minimal Frappe stack.
# Copy this file to .env and review every value before the first run.

# Frappe development image repository.
FRAPPE_IMAGE=frappe/bench

# Exact Frappe Bench image tag used to initialize and run the v16 bench.
FRAPPE_TAG=v5.31.0

# Host user and group IDs kept for compatibility with local compose variants.
HOST_UID=1000
HOST_GID=1000

# Development passwords used by the db, setup, Frappe, and Cypress containers.
DB_ROOT_PASSWORD=mpit_dev_root
ADMIN_PASSWORD=mpit_dev_admin
FRAPPE_PASSWORD=mpit_dev_admin

# Local runtime data root. This directory is ignored by Git.
DATA_ROOT=./data-dev

# Frappe site name created or updated by the setup container.
SITE_NAME=budget.nirolabel.it

# App installation list kept for compatibility with local compose variants.
INSTALL_APPS=master_plan_it

# Path to the local Master Plan IT app repository, relative to this deploy repo.
APP_PATH=../Master-Plan-IT

# Host port mapped to the Frappe development server on container port 8000.
HTTP_PORT=8088

# Host header used by local compose variants and reverse-proxy setups.
FRAPPE_SITE_NAME_HEADER=budget.nirolabel.it

# Time zone used by all services.
TZ=Europe/Rome

# Keep migrations explicit in local compose variants unless intentionally enabled.
RUN_MIGRATE_ON_START=0

# Enable Frappe test execution for the development site created by this stack.
ALLOW_TESTS=1

# Cypress base URL inside the Compose network.
CYPRESS_BASE_URL=http://frappe:8000

# Cypress login user managed by the development setup. Keep this separate from Administrator
# so local password changes do not break smoke tests.
CYPRESS_FRAPPE_USER=cypress@example.local
CYPRESS_FRAPPE_PASSWORD=mpit_cypress_test
