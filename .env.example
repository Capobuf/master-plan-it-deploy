# Development environment – copy to .env and fill values.
# .env is gitignored; do NOT commit it.

FRAPPE_IMAGE=frappe/erpnext
FRAPPE_TAG=v16.10.1

# Match your local user: run `id -u` and `id -g`
HOST_UID=1000
HOST_GID=1000

DB_ROOT_PASSWORD=mpit_dev_root
ADMIN_PASSWORD=mpit_dev_admin

SITE_NAME=localhost
INSTALL_APPS=master_plan_it

HTTP_PORT=9797
FRAPPE_SITE_NAME_HEADER=localhost

# Set to 1 to run bench migrate on every container start (slow; use only if needed)
RUN_MIGRATE_ON_START=0
