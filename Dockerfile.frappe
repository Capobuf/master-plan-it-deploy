ARG FRAPPE_IMAGE=frappe/erpnext
ARG FRAPPE_TAG=v16
FROM ${FRAPPE_IMAGE}:${FRAPPE_TAG}

# Build pipeline only – not used by the production server directly.
# Build context must be the monorepo root (parent of both repos):
#   docker build \
#     -f master-plan-it-deploy/Dockerfile.frappe \
#     --build-arg FRAPPE_TAG=v16.x \
#     -t ghcr.io/yourorg/mpit-frappe:v16.x-1.y.z \
#     .

USER root

# Bake the custom app into the image so prod containers need no bind mount.
COPY --chown=frappe:frappe master_plan_it/ /home/frappe/frappe-bench/apps/master_plan_it/
RUN pip install -e /home/frappe/frappe-bench/apps/master_plan_it --quiet

# Bake the production entrypoint and Procfile so prod containers need no config mounts.
COPY master-plan-it-deploy/config/prod-entrypoint.sh /entrypoint.sh
COPY master-plan-it-deploy/config/prod.Procfile /home/frappe/frappe-bench/Procfile
RUN chmod +x /entrypoint.sh

USER frappe

ENV PYTHONPATH=/home/frappe/frappe-bench/apps:/home/frappe/frappe-bench/apps/frappe:/home/frappe/frappe-bench/apps/erpnext:/home/frappe/frappe-bench/apps/master_plan_it

